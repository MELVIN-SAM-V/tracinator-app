{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracinator",
  "version": "0.1.0",
  "identifier": "com.tracinator.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 420,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5QjQwOTZCMzZCQjVFQzIKUldUQ1hyczJhd20wZVp0SGxkdFJsdCttVVF5V1hVYkoyRFJMdllETUpFS2x2RGx0K2ZXL1Q0bG8K",
      "endpoints": [
        "https://releases.tracinator.com/latest.json"
      ]
    }
  }
}
